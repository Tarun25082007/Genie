# ========================================================
# GENIE: The 2D Literal Monkey's Paw Sandbox Environment Config
# ========================================================
# Copy this file to .env and insert your private API keys.
# .env is ignored by Git to prevent leaking secrets.

# 1. Groq Cloud API Key (LLM Director: llama-3.3-70b-versatile)
# Get a free key at: https://console.groq.com/keys
VITE_GROQ_API_KEY=

# 2. Google Gemini API Key (LLM Director: gemini-2.5-flash)
# Get a free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# 3. Local Ollama Server Configuration (Dual Local Models: Strong & Fast/Weak)
# Download Ollama at: https://ollama.ai/
VITE_OLLAMA_ENDPOINT=http://localhost:11434
VITE_OLLAMA_STRONG_MODEL=llama3.3
VITE_OLLAMA_WEAK_MODEL=llama3.2
